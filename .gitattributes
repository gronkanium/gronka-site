# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force LF for config/build files
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.markdown text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.rb text eol=lf
Gemfile text eol=lf
Gemfile.lock text eol=lf

# Binary files (don't touch)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
